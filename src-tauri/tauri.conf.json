{
  "$schema": "https://schema.tauri.app/config/2.0.0.json",
  "productName": "Petroleum Calculator",
  "version": "1.0.0",
  "identifier": "com.asphalt.calculator",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Petroleum Calculator",
        "width": 1200,
        "height": 800,
        "label": "main"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
