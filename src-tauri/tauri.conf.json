{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asphalt_calculator",
  "version": "1.0.0",
  "identifier": "com.litao.asphalt_calculator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "distDir": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "asphalt_calculator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "identifier": "com.litao.asphalt_calculator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "removeUnusedCommands": true,
    "android": {
      "minSdkVersion": 23,
      "targetSdkVersion": 34
    },
    "ios": {
      "minSdkVersion": 13
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "publisher": "litao",
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "",
    "longDescription": "",
    "deb": {
      "depends": [],
      "files": {}
    },
    "appimage": {
      "bundleMediaFramework": false
    },
    "snap": {
      "confinement": "strict",
      "plugs": ["network", "network-bind"],
      "grade": "stable"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "execute": false,
      "sidecar": false
    },
    "fs": {
      "scope": [],
      "allow": []
    }
  }
}